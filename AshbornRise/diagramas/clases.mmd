%% ============================ VISTAS
class VentanaPrincipal {
  <<JFrame>>
  -VistaInicio vistaInicio
  -VistaJuego vistaJuego
  -VistaBatalla vistaBatalla
  -VistaResultados vistaResultados
  +conectarControladores(cj: ControladorJuego, cb: ControladorBatalla) void
  +mostrarInicio() void
  +mostrarJuego(partida: Partida) void
  +mostrarBatalla() void
  +mostrarResultadosVictoria(recompensa: Recompensa, partida: Partida, rondas: int) void
  +mostrarResultadosDerrota(numeroBatalla: int) void
  +mostrarError(mensaje: String) void
  +getVistaJuego() VistaJuego
  +getVistaBatalla() VistaBatalla
}
class VistaInicio {
  <<JPanel>>
  -ControladorJuego controlador
