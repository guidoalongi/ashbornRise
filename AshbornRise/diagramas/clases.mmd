  +verificarFin() EstadoBatalla
  +otorgarRecompensas() Recompensa
  -armarColaDeTurnos() void
  -avanzarAlSiguienteActor() void
  -buscarEnemigo(c: Combatiente) Enemigo
  +resolverObjetivos(h: Habilidad, origen: Personaje, elegido: Combatiente) List~Combatiente~
  +robarOro(cantidad: int) int
  +consumirItem(item: Item) void
  +registrar(mensaje: String) void
