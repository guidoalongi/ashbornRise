%% ============================ MODELO: acciones
class Accion {
  <<abstract>>
  +ejecutar(actor: Combatiente, batalla: Batalla)* void
}
class AccionAtacar {
  -Combatiente objetivo
  +ejecutar(actor: Combatiente, batalla: Batalla) void
}
class AccionDefender {
  +ejecutar(actor: Combatiente, batalla: Batalla) void
}
class AccionHabilidad {
  -Habilidad habilidad
  -List~Combatiente~ objetivos
  +ejecutar(actor: Combatiente, batalla: Batalla) void
}
class AccionItem {
  -Personaje usuario
  -Item item
  -Personaje objetivo
  +ejecutar(actor: Combatiente, batalla: Batalla) void
}

%% ============================ MODELO: batalla y partida
