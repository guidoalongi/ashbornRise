  +esValido() boolean
  +obtenerVivos() List~Personaje~
  +estaDerrotado() boolean
  +recuperarTrasBatalla() void
  +restaurarCompleto() void
  +getIntegrantes() List~Personaje~
}
class Inventario {
  -List~Item~ items
  -int oro
  +agregarItem(i: Item) void
  +quitarItem(i: Item) void
