  +getNombreClase() String
}
class Curador {
  -double poderCuracion
  +getPoderCuracion() double
  #aplicarMejorasDeNivel() void
  +getNombreClase() String
}

class Enemigo {
  <<abstract>>
  -int experienciaOtorgada
  -int oroOtorgado
  #Random random
  +decidirAccion(batalla: Batalla)* Accion
  +esControladoPorJugador() boolean
