%% ============================ MODELO: habilidades
class Habilidad {
  <<abstract>>
  -String nombre
  -int costoRecurso
  -TipoRecurso tipoRecurso
  -TipoAlcance alcance
  +ejecutar(origen: Combatiente, objetivos: List~Combatiente~)* String
  +getCantidadObjetivos() int
  +getCostoRecurso() int
  +getTipoRecurso() TipoRecurso
  +getAlcance() TipoAlcance
}
class HabilidadOfensiva {
  -double multiplicadorDanio
  -int cantidadObjetivos
  +ejecutar(origen: Combatiente, objetivos: List~Combatiente~) String
  +getCantidadObjetivos() int
}
class HabilidadCuracion {
  -int curacionBase
  -int cantidadObjetivos
  +ejecutar(origen: Combatiente, objetivos: List~Combatiente~) String
  +getCantidadObjetivos() int
}
class HabilidadEstado {
  -TipoEstado efectoAplicado
  -int potencia
  -int duracion
  -boolean limpiaEstadosNegativos
  +ejecutar(origen: Combatiente, objetivos: List~Combatiente~) String
  -crearEstado() EstadoEfecto
  -tieneEstadoNegativo(objetivo: Combatiente) boolean
}

