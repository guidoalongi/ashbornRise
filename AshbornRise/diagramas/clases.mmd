  -Habilidad habilidadElegida
  -Item itemElegido
  +actualizarVista(batalla: Batalla) void
  +mostrarError(mensaje: String) void
  +setControlador(c: ControladorBatalla) void
}
class Modo {
  <<enumeration>>
  NINGUNO
  ATACAR
  ELEGIR_HABILIDAD
  HABILIDAD_A_ENEMIGO
  HABILIDAD_A_ALIADO
  ELEGIR_ITEM
  ITEM_A_ALIADO
}
class VistaResultados {
  <<JPanel>>
  -ControladorJuego controlador
  +mostrarVictoria(recompensa: Recompensa, partida: Partida, rondas: int) void
  +mostrarDerrota(numeroBatalla: int) void
  +setControlador(c: ControladorJuego) void
}
class Estilo {
  <<utilidad>>
  +boton(texto: String)$ JButton
  +etiqueta(texto: String, tamanio: int, color: Color)$ JLabel
  +barra(valor: int, maximo: int, color: Color)$ JProgressBar
  +tarjeta()$ JPanel
}
class Main {
  +main(args: String[])$ void
}

%% ============================ RELACIONES
Combatiente <|-- Personaje
Combatiente <|-- Enemigo
Personaje <|-- Guerrero
Personaje <|-- Mago
Personaje <|-- Arquero
Personaje <|-- Curador
Enemigo <|-- GoblinMerodeador
Enemigo <|-- EsqueletoGuerrero
Enemigo <|-- ChamanOscuro
Enemigo <|-- AranaVenenosa
Enemigo <|-- SenorDeLasSombras
Habilidad <|-- HabilidadOfensiva
Habilidad <|-- HabilidadCuracion
Habilidad <|-- HabilidadEstado
EstadoEfecto <|-- Veneno
EstadoEfecto <|-- Escudo
EstadoEfecto <|-- Aturdimiento
Item <|-- Consumible
Accion <|-- AccionAtacar
Accion <|-- AccionDefender
Accion <|-- AccionHabilidad
Accion <|-- AccionItem
IPersistencia <|.. PersistenciaArchivoJSON

Combatiente "1" o-- "0..*" EstadoEfecto : posee
Personaje "1" o-- "0..*" Habilidad : conoce
ChamanOscuro "1" --> "1" Habilidad : curacionOscura
HabilidadEstado ..> EstadoEfecto : crea
Partida "1" *-- "1" Equipo
Partida "1" *-- "1" Inventario
Equipo "1" *-- "2..4" Personaje
Inventario "1" *-- "0..*" Item
Batalla "1" o-- "1" Equipo : aliados
Batalla "1" o-- "1..*" Enemigo : enemigos
Batalla "1" o-- "1" Inventario
Batalla "1" --> "1" GestorTurnos : usa
Batalla ..> Recompensa : crea
Batalla ..> Accion : ejecuta
Enemigo ..> Accion : decide
AccionHabilidad --> Habilidad
AccionItem --> Item
Partida ..> Batalla : crea
Partida ..> FabricaJuego : usa
PersistenciaArchivoJSON ..> Partida
PersistenciaArchivoJSON ..> FabricaJuego : usa
Batalla --> EstadoBatalla
Personaje --> TipoRecurso
Habilidad --> TipoRecurso
Habilidad --> TipoAlcance
HabilidadEstado --> TipoEstado
EstadoEfecto ..> TipoEstado
Mago --> TipoElemento
Consumible --> TipoEfectoConsumible

ControladorJuego --> Partida
ControladorJuego --> IPersistencia
ControladorJuego --> VentanaPrincipal
ControladorJuego --> ControladorBatalla
ControladorBatalla --> Batalla
ControladorBatalla --> VistaBatalla
ControladorBatalla --> ControladorJuego
ControladorBatalla ..> Accion : crea
VentanaPrincipal *-- VistaInicio
VentanaPrincipal *-- VistaJuego
VentanaPrincipal *-- VistaBatalla
VentanaPrincipal *-- VistaResultados
VistaInicio --> ControladorJuego
VistaJuego --> ControladorJuego
VistaResultados --> ControladorJuego
VistaBatalla --> ControladorBatalla
VistaBatalla --> Modo
Main ..> VentanaPrincipal : crea
Main ..> ControladorJuego : crea
Main ..> ControladorBatalla : crea
VistaBatalla ..> Estilo : usa
VistaJuego ..> Estilo : usa
