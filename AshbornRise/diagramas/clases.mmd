%% ============================ MODELO: combatientes
class Combatiente {
  <<abstract>>
  #String nombre
  #int vidaActual
  #int vidaMaximo
  #int ataque
  #int defensa
  #int velocidad
  #List~EstadoEfecto~ estados
  #boolean defendiendo
  +atacar(objetivo: Combatiente) int
  +calcularDanio() int
  +recibirDanio(cantidad: int) int
  +perderVida(cantidad: int) void
  +curar(cantidad: int) int
  +defenderse() void
  +usarHabilidad(h: Habilidad, objetivos: List~Combatiente~) String
  +getPoderCuracion() double
  +estaVivo() boolean
  +obtenerVelocidad() int
  +iniciarTurno() boolean
  +aplicarEstados() void
  +agregarEstado(e: EstadoEfecto) boolean
  +puedeRecibirEstado(tipo: TipoEstado) boolean
  +quitarEstado(tipo: TipoEstado) boolean
  +tieneEstado(tipo: TipoEstado) boolean
  +quitarTodosLosEstados() void
  +alGolpear(objetivo: Combatiente, batalla: Batalla) void
  +reaccionarAAtaque(atacante: Combatiente, batalla: Batalla) void
  +esControladoPorJugador()* boolean
}

class Personaje {
  <<abstract>>
  -int nivel
  -int experiencia
  -int recursoActual
  -int recursoMaximo
  -TipoRecurso tipoRecurso
  -int regeneracionMana
  -List~Habilidad~ habilidades
  +atacar(objetivo: Combatiente) int
  +recibirDanio(cantidad: int) int
  +defenderse() void
  +iniciarTurno() boolean
  +puedeUsar(h: Habilidad) boolean
  +usarHabilidad(h: Habilidad, objetivos: List~Combatiente~) String
  +usarItem(i: Item, objetivo: Personaje) String
  +consumirRecurso(cantidad: int) void
  +recuperarRecurso(cantidad: int) int
  +experienciaParaSubir() int
  +ganarExperiencia(cantidad: int) int
  +subirNivel() void
  #aplicarMejorasDeNivel()* void
  #mejorarEstadisticas(vida: int, recurso: int, ataque: int, defensa: int) void
  #aprenderHabilidad(h: Habilidad) void
  +recuperarTrasBatalla() void
  +restaurarCompleto() void
  +restaurarProgreso(nivel: int, experiencia: int, vida: int, recurso: int) void
  +getNombreClase()* String
  +esControladoPorJugador() boolean
}

class Guerrero {
  -int probabilidadContraataque
  -Random random
  +reaccionarAAtaque(atacante: Combatiente, batalla: Batalla) void
  #aplicarMejorasDeNivel() void
