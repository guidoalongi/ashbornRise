sequenceDiagram
    actor Jugador
    participant VB as VistaBatalla
    participant CB as ControladorBatalla
    participant B as Batalla
    participant AA as accion:AccionAtacar
    participant G as guerrero:Guerrero
    participant GO as goblin:GoblinMerodeador
    participant CT as continuar:ContinuarTurnos
    participant PA as arena:PanelArena

    Jugador->>VB: clic "ATACAR" + clic en el goblin
    VB->>CB: atacar(goblin)
    CB->>B: getPersonajeActual()
    B-->>CB: guerrero
    CB->>AA: new AccionAtacar(goblin)
    CB->>B: ejecutarTurno(guerrero, accion)
    activate B
    B->>AA: ejecutar(guerrero, batalla)
    activate AA
    AA->>G: atacar(goblin)
    activate G
    G->>G: calcularDanio()
    G->>GO: recibirDanio(danio)
    activate GO
    GO->>GO: perderVida(danioReal)
    GO-->>G: danioReal
    deactivate GO
    G-->>AA: danioReal
    deactivate G
    AA->>B: registrar("Bram ataca a Goblin por N de daño.")
    AA->>G: alGolpear(goblin, batalla)
    AA->>GO: estaVivo()
    GO-->>AA: resultado
    opt el goblin sigue vivo
        AA->>GO: reaccionarAAtaque(guerrero, batalla)
    end
    deactivate AA
    B->>B: verificarFin()
    opt estado == EN_CURSO
        B->>B: avanzarAlSiguienteActor()
    end
    deactivate B
    CB->>CT: new ContinuarTurnos(this)
    CB->>VB: animarTurno(batalla, continuar)
    activate VB
    VB->>PA: animarTurno(batalla, lineasNuevas, ...)
    Note over VB,PA: La arena lee getUltimoActor() y getUltimaAccion()<br/>y reproduce la animación (1 o 2 segundos)
    PA-->>VB: terminó la animación
    VB->>CT: run()
    deactivate VB
    CT->>CB: continuarTurnos()
    alt le toca a un enemigo
        CB->>B: ejecutarTurnoEnemigo()
        CB->>VB: animarTurno(batalla, new ContinuarTurnos(this))
        Note over VB,B: se repite hasta que le toque a un personaje o termine la batalla
    else le toca a un personaje
        CB->>VB: actualizarVista(batalla)
        VB-->>Jugador: habilita los botones para el siguiente turno
    end
